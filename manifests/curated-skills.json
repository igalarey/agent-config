      "id": "knowledge-audit-2026-11-05",
      "basisCommit": "e8f5e36bf188d3195e61f8b598aa9f462330530a",
      "changes": [
        {
          "skills": ["security-review"],
          "notes": [
            "Replace blanket exclusions with trust-boundary analysis, separate confidence from severity, and retain conditional risks and unknowns.",
            "Correct path containment and symlink/race limits, pickle versus PyTorch options, and JSON parsing guidance.",
            "Remove absent review helpers and framework integration mandates; retain the existing illustrative CWE fixture pairs."
          ]
        },
        {
          "skills": ["context7-mcp", "enforce-first", "deepen-architecture", "smoke-test", "validate-contracts", "simple-english"],
          "notes": [
            "Make procedures and companion references self-contained with explicit optional runtimes, MCP/network tools, project policy, and validation limits.",
            "Remove original-repository cache, churn, boundary, smoke, contract, and convention prerequisites without reinstalling their framework.",
            "Keep smoke checks read-only and separate deployment, repair, authentication, private access, and persistent artifacts from validation."
          ]
        },
        {
          "skills": ["edit-document", "design-interface", "define-language", "elaborate-spec", "grill-me", "deepen-architecture"],
          "notes": [
            "Remove arbitrary paragraph limits, fixed delegation quotas, absent companion workflows, and routine clarification gates.",
            "Narrow triggers and preserve explicit authorization for writes, implementation, network actions, and persistent planning."
          ]
        },
        {
          "skills": ["align-grid"],
          "notes": [
            "Retain modular grid scaffold and measurements, remove automatic publishing and unavailable image/hosting tools, and make browser prerequisites explicit.",
            "Remove remote font links from generated scaffolds; support the repository ESM context, local file paths, dependency-free help, and the default browser sandbox."
          ]
        }
      ]
    }
  ],
