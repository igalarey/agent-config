{
  "packages": [
    "npm:pi-mcp-adapter@2.33.0",
    "npm:pi-web-access@0.29.0",
    "npm:pi-ollama@0.1.7",
    "npm:pi-claude-bridge@0.8.0"
  ],
  "theme": "carbon-violet",
  "editorPaddingX": 2,
  "outputPad": 1,
  "hideThinkingBlock": true,
  "quietStartup": false,
  "collapseChangelog": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "observational-memory": {
    "compactAtContextTokens": 150000,
    "tailTokens": 20000,
    "models": {
      "observer": {
        "provider": "openai-codex",
        "id": "gpt-6-luna",
        "thinking": "high"
      },
      "consolidator": {
        "provider": "openai-codex",
        "id": "gpt-6-luna",
        "thinking": "high"
      }
    }
  }
}
