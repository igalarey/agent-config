#!/bin/sh
pi_bin=$(command -v pi) || exit 127
exec ghostty \
  --font-family="JetBrainsMono Nerd Font Mono" \
  --font-size=12 \
  --adjust-cell-height=2 \
  --background=1b1e1c \
  --foreground=d8dcd9 \
  --cursor-color=b29add \
  --selection-background=49405a \
  --selection-foreground=f0eafa \
  --background-opacity=1 \
  --window-padding-x=26 \
  --window-padding-y=24 \
  -e "$pi_bin" "$@"
